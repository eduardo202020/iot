# Dependencies are installed by EAS from package-lock.json.
node_modules/
/node_modules
**/node_modules/

# Local VCS and Expo caches are not needed by the remote builder.
.git/
/.git
.expo/
.eas/
.vscode/

# Build outputs and native folders generated by Expo/EAS.
dist/
web-build/
android/
ios/
.gradle/
.kotlin/

# Local environment files. EAS receives public demo URLs from eas.json.
.env
.env.*
!.env.example
!.env.raspberry.example

# Local logs, diagnostics, and temporary files.
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
*.tsbuildinfo
.metro-health-check*

# Project documentation and generated reports are useful locally, not in builds.
docs/
README*.md
ARCHITECTURE.md
ROADMAP.md
app-example/

# OS/editor noise.
.DS_Store
*.orig.*
