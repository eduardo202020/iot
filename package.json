{
  "name": "museiq",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --tunnel",
    "dev:client": "expo start --dev-client --tunnel",
    "dev:client:lan": "bash ./scripts/start-devclient-lan.sh",
    "android:dev:prepare": "APP_VARIANT=development npx expo prebuild --platform android --no-install",
    "android:dev": "npm run android:dev:prepare && APP_VARIANT=development expo run:android --device",
    "android:release:prepare": "APP_VARIANT=production npx expo prebuild --platform android --no-install",
    "android:release": "npm run android:release:prepare && cd android && APP_VARIANT=production NODE_ENV=production ./gradlew --no-daemon --max-workers=2 -PreactNativeArchitectures=arm64-v8a :app:assembleRelease",
    "android:release:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "docs:qr": "node ./scripts/generate-artwork-qr-sheet.mjs",
    "wsl:portproxy": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/expo-wsl-portproxy.ps1",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "qa:ar": "node ./scripts/validate-ar-catalog.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reactvision/react-viro": "^2.55.0",
    "buffer": "^6.0.3",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-gl": "~16.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-sensors": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.0",
    "@types/three": "^0.184.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
