# El MVP intenta primero la API MuseRAG para demostrar la integración real.
EXPO_PUBLIC_MUSERAG_MODE=remote

# MuseRAG API URL, used when EXPO_PUBLIC_MUSERAG_MODE=remote
EXPO_PUBLIC_MUSERAG_URL=http://localhost:8000

# Para probar por USB en Android: ejecuta `adb reverse tcp:8000 tcp:8000`, usa
# 127.0.0.1 en la URL y activa esta bandera. En la feria por Wi-Fi, dejala en 0.
EXPO_PUBLIC_MUSERAG_USE_ADB_REVERSE=0

# Si la API o el proveedor de IA fallan durante la feria, conserva una
# respuesta curatorial trazable dentro de la app.
EXPO_PUBLIC_MUSERAG_ALLOW_LOCAL_FALLBACK=1

# Solicita voz neural a /api/voz y vuelve a expo-speech si Google Cloud o la
# red no estan disponibles. Nunca coloques credenciales de Google en Expo.
EXPO_PUBLIC_MUSERAG_REMOTE_TTS=1

# Opt-in para que el bridge HTTP de iot-museiq pueda dominar la ubicacion BLE.
# Sin este valor, BLE fisico sigue siendo la fuente predeterminada.
EXPO_PUBLIC_MUSEIQ_HARNESS_MODE=0
EXPO_PUBLIC_MUSEIQ_BLE_SIM_URL=http://localhost:8787
