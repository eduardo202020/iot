# Copia este valor a .env cuando MuseRAG corra en la Raspberry Pi.
# Reemplaza IP_RASPBERRY por la IP LAN que devuelve `hostname -I` en la Pi.
EXPO_PUBLIC_MUSERAG_URL=http://IP_RASPBERRY:8000

# Si tambien corres el bridge BLE/simulador en la Raspberry, ajusta esta URL.
# Si no lo usas ahi, conserva tu URL actual de iot-museiq.
EXPO_PUBLIC_MUSEIQ_BLE_SIM_URL=http://IP_RASPBERRY:8787
